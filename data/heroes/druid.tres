[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/heroes/hero_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"druid"
title = "Друїд"
description = "Хранитель лісу. Б'є чарами природи, а в бою обертається на Ведмедя — броньованого, живучого, повільного — або на Фенріра, прудкого вовка, що рве ворогів серією укусів."
color = Color(0.4, 0.85, 0.45, 1)
unlock_cost = 0
skill_ids = Array[StringName]([&"bear_form", &"fenrir_form"])
