[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/heroes/hero_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"archer"
title = "Лучник"
description = "Прудкий стрілець: б'є здалеку, тримає ворогів на відстані. Віяло стріл косить натовп, пробивний постріл прошиває всю лінію."
color = Color(0.55, 0.85, 0.35, 1)
bonus_max_hp = -5.0
move_speed_percent = 0.1
skill_ids = Array[StringName]([&"arrow_volley", &"piercing_shot"])
