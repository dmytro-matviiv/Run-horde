extends Node

## Налаштування продуктивності під пристрій.
##
## На телефоні 3D малюється у 75% роздільної здатності екрана, а кадри
## обмежені шістдесятьма. Причина проста: сучасні телефони мають дуже
## щільні екрани, і чесний рендер у повну роздільність з'їдає батарею й
## гріє пристрій, майже не додаючи чіткості на п'ятидюймовому екрані.
##
## Інтерфейс це не зачіпає — він завжди малюється різко.

const MOBILE_RENDER_SCALE := 0.75
const MOBILE_MAX_FPS := 60

func _ready() -> void:
	if not OS.has_feature("mobile"):
		return
	get_tree().root.scaling_3d_scale = MOBILE_RENDER_SCALE
	Engine.max_fps = MOBILE_MAX_FPS
