grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="Panel"]
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Panel/VBoxContainer"]
theme_override_font_sizes/font_size = 30
text = "Пауза"
horizontal_alignment = 1

[node name="HintLabel" type="Label" parent="Panel/VBoxContainer"]
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.66, 0.69, 0.8, 1)
text = "Бій зупинено. Куплені апгрейди й герої в безпеці."
