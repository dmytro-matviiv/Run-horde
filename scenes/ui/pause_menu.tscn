text = "Продовжити"

[node name="QuitButton" type="Button" parent="Panel/VBoxContainer"]
custom_minimum_size = Vector2(0, 52)
theme_override_font_sizes/font_size = 18
text = "Вийти без збереження"

[node name="ConfirmRow" type="VBoxContainer" parent="Panel/VBoxContainer"]
theme_override_constants/separation = 10

[node name="WarnLabel" type="Label" parent="Panel/VBoxContainer/ConfirmRow"]
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.95, 0.4, 0.4, 1)
text = "Золото й рівні цього рану буде втрачено. Вийти?"
