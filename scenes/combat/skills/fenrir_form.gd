extends "res://scenes/combat/skills/druid_form.gd"

## ФОРМА ФЕНРІРА: друїд стає примарним вовком — на 35% швидший, кусає
## часто, і кожен укус поспіль сильніший (до 5 разів). Прийоми форми:
## "Кровотік" (рани кровоточать) і "Наскок" (стрибок на ворога й серія
## ударів, поки він безпорадний). Натиснути ще раз — назад у людину.

func _init() -> void:
	super()
	id = &"fenrir_form"
	form = &"fenrir"
	title = "Фенрір"
	description = "Перетворення на Фенріра: на 35% швидший, укуси поспіль сильніші (до 5 разів). Нові прийоми — «Кровотік» і «Наскок». Ще раз — назад у людину."
	color = Color(0.45, 0.9, 0.75)
	icon_kind = "dash"
